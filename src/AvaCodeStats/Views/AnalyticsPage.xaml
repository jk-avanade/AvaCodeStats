<UserControl x:Class="AvaCodeStats.Views.AnalyticsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:AvaCodeStats.Controls"
             xmlns:sp="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="36,4,36,32" MaxWidth="1120">
            <Grid Margin="0,0,0,20">
                <TextBlock x:Name="Intro" Style="{StaticResource Caption}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,320,0" />
                <Border Style="{StaticResource SegmentedHost}" HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource Segment}" GroupName="Range" Content="24 hours" Tag="24h" Checked="OnRange" />
                        <RadioButton Style="{StaticResource Segment}" GroupName="Range" Content="7 days" Tag="7d" Checked="OnRange" />
                        <RadioButton x:Name="Range30" Style="{StaticResource Segment}" GroupName="Range" Content="30 days" Tag="30d" Checked="OnRange" />
                        <RadioButton Style="{StaticResource Segment}" GroupName="Range" Content="90 days" Tag="90d" Checked="OnRange" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,24,0">
                    <TextBlock x:Name="Total" Style="{StaticResource HeroNumber}" FontSize="44" />
                    <TextBlock x:Name="Sub" Style="{StaticResource Caption}" FontSize="13" Margin="0,2,0,0" />
                    <Grid x:Name="UnpricedNote" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE946;" Style="{StaticResource Glyph}" FontSize="13" VerticalAlignment="Top" Margin="0,2,8,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="Unpriced" Grid.Column="1" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                    </Grid>
                    <ItemsControl x:Name="Providers" Margin="0,20,0,0" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition />
                                        <RowDefinition />
                                    </Grid.RowDefinitions>
                                    <Ellipse Width="9" Height="9" Fill="{Binding Dot}" VerticalAlignment="Center" HorizontalAlignment="Left" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource BodyStrong}" />
                                        <TextBlock Text="{Binding Sessions}" Style="{StaticResource Caption}" Margin="8,0,0,0" VerticalAlignment="Bottom" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding Value}" Style="{StaticResource BodyStrong}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Detail}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <Border Grid.Column="1" Style="{StaticResource Card}" Padding="16,14,8,8">
                    <StackPanel>
                        <TextBlock x:Name="ChartTitle" Style="{StaticResource BodyStrong}" Margin="4,0,0,4" />
                        <sp:WpfPlot x:Name="Chart" Height="270" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                <StackPanel>
                    <TextBlock Text="Totals" Style="{StaticResource BodyStrong}" Margin="0,0,0,12" />
                    <ItemsControl x:Name="Totals" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource Caption}" />
                                    <TextBlock Text="{Binding Value}" Style="{StaticResource KpiValue}" Margin="0,2,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="SpeedColumn" Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock x:Name="TypeTitle" Style="{StaticResource BodyStrong}" />
                        <c:StackBar x:Name="TypeBar" Margin="0,14,0,12" />
                        <ItemsControl x:Name="TypeLegend" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,18,4">
                                        <Border Width="10" Height="10" CornerRadius="2" Background="{Binding Swatch}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource Caption}" FontSize="13" Margin="6,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Value}" Style="{StaticResource BodyStrong}" FontSize="13" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Border x:Name="SpeedCard" Grid.Column="1" Style="{StaticResource Card}" Margin="16,0,0,0">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Cost by speed" Style="{StaticResource BodyStrong}" />
                            <TextBlock x:Name="FastPremium" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                        </Grid>
                        <c:StackBar x:Name="SpeedBar" Margin="0,14,0,12" />
                        <ItemsControl x:Name="SpeedLegend" Focusable="False" ItemTemplate="{Binding ItemTemplate, ElementName=TypeLegend}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="20,16,20,8">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="Breakdown" Style="{StaticResource BodyStrong}" VerticalAlignment="Center" />
                        <Border Style="{StaticResource SegmentedHost}" HorizontalAlignment="Right">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="ByModel" Style="{StaticResource Segment}" GroupName="Breakdown" Content="Model" IsChecked="True" Checked="OnBreakdown" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="Breakdown" Content="Day" Checked="OnBreakdown" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Grid Margin="0,4,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="110" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="#" Style="{StaticResource Caption}" />
                        <TextBlock x:Name="NameHeader" Grid.Column="1" Text="Model" Style="{StaticResource Caption}" />
                        <TextBlock Grid.Column="2" Text="Cost" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="3" Text="Share" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="4" Text="Tokens" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                    </Grid>
                    <ItemsControl x:Name="Rows" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="110" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Rank}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Margin="0,0,24,0">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="8" Height="8" Fill="{Binding Dot}" Visibility="{Binding DotVisibility}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource Body}" />
                                            </StackPanel>
                                            <Grid Margin="0,6,0,0" Height="3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="{Binding ShareLength}" />
                                                    <ColumnDefinition Width="{Binding RestLength}" />
                                                </Grid.ColumnDefinitions>
                                                <Border Background="{Binding Bar}" CornerRadius="1.5" MinWidth="3" />
                                            </Grid>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding Cost}" Style="{StaticResource Body}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="{Binding Share}" Style="{StaticResource Caption}" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="4" Text="{Binding Tokens}" Style="{StaticResource Body}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
