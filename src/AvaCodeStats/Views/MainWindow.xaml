<Window x:Class="AvaCodeStats.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AvaCodeStats" Width="1240" Height="880" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Navigation rail -->
        <DockPanel Grid.Column="0" Margin="8,12,4,12">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="14,4,0,20">
                <Image x:Name="AppIcon" Width="20" Height="20" />
                <TextBlock Text="AvaCodeStats" Style="{StaticResource BodyStrong}" Margin="10,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <RadioButton x:Name="NavSettings" DockPanel.Dock="Bottom" Style="{StaticResource NavItem}" GroupName="Nav"
                         Tag="&#xE713;" Content="Settings" Checked="OnNav" />
            <StackPanel>
                <RadioButton x:Name="NavLimits" Style="{StaticResource NavItem}" GroupName="Nav" Tag="&#xEC4A;" Content="Limits" Checked="OnNav" />
                <RadioButton x:Name="NavBurn" Style="{StaticResource NavItem}" GroupName="Nav" Tag="&#xE9D2;" Content="Burn" Checked="OnNav" />
                <RadioButton x:Name="NavCost" Style="{StaticResource NavItem}" GroupName="Nav" Tag="&#xE8C7;" Content="Cost" Checked="OnNav" />
                <RadioButton x:Name="NavTokens" Style="{StaticResource NavItem}" GroupName="Nav" Tag="&#xE943;" Content="Tokens" Checked="OnNav" />
            </StackPanel>
        </DockPanel>

        <!-- Page area -->
        <Border Grid.Column="1" Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1,1,0,0" CornerRadius="8,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Margin="36,24,28,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="PageTitle" Style="{StaticResource PageTitle}" Text="Limits" />
                        <Border Style="{StaticResource Aurora}" Margin="0,8,0,0" />
                    </StackPanel>
                    <StackPanel x:Name="HeaderTools" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="ProfileSwitch" Style="{StaticResource SegmentedHost}" ToolTip="Which subscriptions this window shows">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="ProfileWork" Style="{StaticResource Segment}" GroupName="Profile" Content="Work" Tag="work" Checked="OnProfile" />
                                <RadioButton x:Name="ProfilePersonal" Style="{StaticResource Segment}" GroupName="Profile" Content="Personal" Tag="personal" Checked="OnProfile" />
                                <RadioButton x:Name="ProfileUnified" Style="{StaticResource Segment}" GroupName="Profile" Content="All" Tag="unified" Checked="OnProfile" />
                            </StackPanel>
                        </Border>
                        <Button x:Name="RefreshButton" Style="{StaticResource IconButton}" Content="&#xE72C;" Margin="8,0,0,0"
                                ToolTip="Refresh now" Click="OnRefresh" />
                    </StackPanel>
                </Grid>

                <ContentControl x:Name="Host" Grid.Row="1" Focusable="False" />

                <TextBlock x:Name="Status" Grid.Row="2" Style="{StaticResource Caption}" Margin="36,6,28,10" TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>
    </Grid>
</Window>
