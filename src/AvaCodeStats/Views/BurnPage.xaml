<UserControl x:Class="AvaCodeStats.Views.BurnPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:AvaCodeStats.Controls"
             xmlns:sp="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="36,4,36,32" MaxWidth="1120">
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="Picker" MinWidth="380" SelectionChanged="OnPick" />
                <TextBlock x:Name="Plan" Grid.Column="1" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="16,0,0,0" />
            </Grid>

            <TextBlock x:Name="Empty" Style="{StaticResource Body}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />

            <StackPanel x:Name="Body">
                <Border Style="{StaticResource Card}" Padding="24">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="210" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="190" Height="190" VerticalAlignment="Center" HorizontalAlignment="Left">
                            <c:RingView x:Name="Ring" />
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock x:Name="RingValue" Style="{StaticResource BigNumber}" HorizontalAlignment="Center" />
                                <TextBlock x:Name="RingCaption" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="HeadlineGlyph" Style="{StaticResource Glyph}" FontSize="18" />
                                <TextBlock x:Name="Headline" Style="{StaticResource Subtitle}" Margin="8,0,0,0" />
                            </StackPanel>
                            <TextBlock x:Name="Period" Style="{StaticResource Caption}" Margin="0,4,0,16" />
                            <ItemsControl x:Name="Kpis" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="4" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,12,16">
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource Caption}" />
                                            <TextBlock Text="{Binding Value}" Style="{StaticResource KpiValue}" Foreground="{Binding Brush}" Margin="0,2,0,0" />
                                            <TextBlock Text="{Binding Note}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource SegmentedHost}" HorizontalAlignment="Left" Margin="0,20,0,10">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="TabPeriod" Style="{StaticResource Segment}" GroupName="BurnTab" Content="Burn this period" IsChecked="True" Checked="OnTab" />
                        <RadioButton x:Name="TabDaily" Style="{StaticResource Segment}" GroupName="BurnTab" Content="Daily burn" Checked="OnTab" />
                        <RadioButton x:Name="TabHistory" Style="{StaticResource Segment}" GroupName="BurnTab" Content="History" Checked="OnTab" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="8" Height="400">
                    <sp:WpfPlot x:Name="Chart" />
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
