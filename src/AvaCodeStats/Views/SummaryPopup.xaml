<Window x:Class="AvaCodeStats.Views.SummaryPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:AvaCodeStats.Controls"
        Title="AvaCodeStats summary" Width="380" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        ShowActivated="True" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
    <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
        <!-- Header and footer stay put; the list scrolls when the window hits its max height. -->
        <DockPanel>
            <Grid DockPanel.Dock="Top" Margin="16,14,10,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="AvaCodeStats" Style="{StaticResource BodyStrong}" />
                    <Border Style="{StaticResource Aurora}" Width="40" Margin="0,5,0,0" />
                </StackPanel>
                <Border Grid.Column="1" Style="{StaticResource SegmentedHost}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="Work" Style="{StaticResource Segment}" GroupName="PopupProfile" Content="Work" Tag="work" Checked="OnProfile" />
                        <RadioButton x:Name="Personal" Style="{StaticResource Segment}" GroupName="PopupProfile" Content="Personal" Tag="personal" Checked="OnProfile" />
                        <RadioButton x:Name="All" Style="{StaticResource Segment}" GroupName="PopupProfile" Content="All" Tag="unified" Checked="OnProfile" />
                    </StackPanel>
                </Border>
                <Button x:Name="RefreshButton" Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE72C;" Margin="4,0,0,0" ToolTip="Refresh now" Click="OnRefresh" />
            </Grid>

            <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="16,10">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Open dashboard" Style="{DynamicResource AccentButtonStyle}" Margin="12,0,0,0" Click="OnOpen" />
                    <TextBlock x:Name="Updated" Style="{StaticResource Caption}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Border>

            <TextBlock x:Name="Empty" DockPanel.Dock="Top" Style="{StaticResource Caption}" Margin="16,8,16,16" TextWrapping="Wrap" Visibility="Collapsed" />

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <!-- One card per subscription; one compact row per quota. Shared sizes keep the bars aligned across cards. -->
                <ItemsControl x:Name="Groups" Margin="8,0,8,4" Focusable="False" Grid.IsSharedSizeScope="True">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,4,0,6">
                                <Border Style="{StaticResource GroupHeader}" Margin="0,0,0,3" Padding="4,3,6,3" MouseLeftButtonUp="OnGroupClick">
                                    <!-- The name wins over the plan: the plan trims first. -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource GroupChevron}" FontSize="9" Margin="0,0,4,0" />
                                        <Ellipse Grid.Column="1" Width="8" Height="8" Fill="{Binding Dot}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding Name}" Style="{StaticResource BodyStrong}" FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="{Binding HiddenText}" Style="{StaticResource Caption}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="4" Text="{Binding Meta}" ToolTip="{Binding Meta}" Style="{StaticResource Caption}" Margin="12,0,0,0"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource Card}" Padding="3" CornerRadius="6">
                                    <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <Rectangle Style="{StaticResource RowDivider}" Margin="8,1" />
                                                    <Border Style="{StaticResource ClickableRow}" Padding="9,6" CornerRadius="4"
                                                            MouseLeftButtonUp="OnItem" ToolTip="{Binding ResetTooltip}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" SharedSizeGroup="Title" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" SharedSizeGroup="Left" />
                                                            </Grid.ColumnDefinitions>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>
                                                            <TextBlock Text="{Binding Title}" Style="{StaticResource BodyStrong}" FontSize="13" MaxWidth="160"
                                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                            <c:LimitBar Grid.Column="1" Left="{Binding LeftFraction}" TimeLeft="{Binding TimeLeftFraction}" Status="{Binding Status}"
                                                                        Height="8" Margin="12,0,12,0" VerticalAlignment="Center" />
                                                            <!-- Runs share a baseline; right-aligned so "left" lines up whatever the number's width. -->
                                                            <TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                                <Run Text="{Binding LeftPercent, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                                <Run Text="left" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                            </TextBlock>
                                                            <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="0,3,0,0">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding StatusGlyph}" Style="{StaticResource Glyph}" FontSize="10" Foreground="{Binding StatusBrush}" />
                                                                    <TextBlock Text="{Binding PaceText}" Style="{StaticResource Caption}" Foreground="{Binding StatusBrush}" Margin="5,0,0,0" />
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding ResetText}" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                                                            </Grid>
                                                        </Grid>
                                                    </Border>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
