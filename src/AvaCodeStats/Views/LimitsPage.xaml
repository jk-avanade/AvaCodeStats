<UserControl x:Class="AvaCodeStats.Views.LimitsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:AvaCodeStats.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="36,4,36,32" MaxWidth="1120" HorizontalAlignment="Stretch">

            <!-- How to read the bars -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Border Width="22" Height="10" CornerRadius="3" Background="{DynamicResource StatusGoodBrush}" VerticalAlignment="Center" />
                <TextBlock Style="{StaticResource Caption}" Text="Left" Margin="6,0,16,0" VerticalAlignment="Center" />
                <Border Width="2.5" Height="14" Background="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                <TextBlock Style="{StaticResource Caption}" Margin="6,0,0,0" VerticalAlignment="Center"
                           Text="Even pace: where the bar would end if you spread the quota evenly. Past it, you have budget in hand." />
            </StackPanel>

            <TextBlock x:Name="Empty" Style="{StaticResource Body}" Margin="0,24,0,0" TextWrapping="Wrap" Visibility="Collapsed"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

            <!-- One card per subscription; one compact row per quota. Shared sizes keep the bars aligned across cards. -->
            <ItemsControl x:Name="Groups" Focusable="False" Grid.IsSharedSizeScope="True">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,12,0,0">
                            <Border Style="{StaticResource GroupHeader}" Margin="-6,0,-6,6" Padding="6,4" MouseLeftButtonUp="OnGroupClick">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource GroupChevron}" Margin="0,0,8,0" />
                                    <Ellipse Grid.Column="1" Width="10" Height="10" Fill="{Binding Dot}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding Name}" Style="{StaticResource BodyStrong}" FontSize="16" Margin="10,0,0,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{Binding HiddenText}" Style="{StaticResource Caption}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="4" Text="{Binding Meta}" ToolTip="{Binding Meta}" Style="{StaticResource Caption}" Margin="16,0,0,0"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource Card}" Padding="4">
                                <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <Rectangle Style="{StaticResource RowDivider}" Margin="12,2" />
                                                <Border Style="{StaticResource ClickableRow}" Padding="16,9"
                                                        MouseLeftButtonUp="OnCardClick" ToolTip="Open the burn chart">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="220" />
                                                            <ColumnDefinition Width="Auto" SharedSizeGroup="Left" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Title}" Style="{StaticResource BodyStrong}" TextTrimming="CharacterEllipsis" />
                                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                                <TextBlock Text="{Binding StatusGlyph}" Style="{StaticResource Glyph}" FontSize="11" Foreground="{Binding StatusBrush}" />
                                                                <TextBlock Text="{Binding PaceText}" Style="{StaticResource Caption}" Foreground="{Binding StatusBrush}" Margin="6,0,0,0" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <!-- Runs share a baseline; right-aligned so "left" lines up whatever the number's width. -->
                                                        <TextBlock Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,24,0">
                                                            <Run Text="{Binding LeftPercent, Mode=OneWay}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                            <Run Text="left" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                        </TextBlock>
                                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                            <c:LimitBar Left="{Binding LeftFraction}" TimeLeft="{Binding TimeLeftFraction}" Status="{Binding Status}" Height="14" />
                                                            <Grid Margin="0,6,0,0">
                                                                <TextBlock Text="{Binding Usage}" Style="{StaticResource Caption}" />
                                                                <TextBlock Text="{Binding ResetText}" ToolTip="{Binding ResetTooltip}" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                                                            </Grid>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
