<UserControl x:Class="AvaCodeStats.Views.LimitsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:AvaCodeStats.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="36,4,36,32" MaxWidth="1120" HorizontalAlignment="Stretch">

            <!-- How to read the bars -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Border Width="22" Height="10" CornerRadius="3" Background="{DynamicResource StatusGoodBrush}" VerticalAlignment="Center" />
                <TextBlock Style="{StaticResource Caption}" Text="Left" Margin="6,0,16,0" VerticalAlignment="Center" />
                <Border Width="2.5" Height="14" Background="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                <TextBlock Style="{StaticResource Caption}" Margin="6,0,0,0" VerticalAlignment="Center"
                           Text="Even pace: where the bar would end if you spread the quota evenly. Past it, you have budget in hand." />
            </StackPanel>

            <TextBlock x:Name="Empty" Style="{StaticResource Body}" Margin="0,24,0,0" TextWrapping="Wrap" Visibility="Collapsed"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

            <ItemsControl x:Name="Groups" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,20,0,0">
                            <Grid Margin="2,0,2,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="10" Height="10" Fill="{Binding Dot}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource BodyStrong}" FontSize="16" Margin="10,0,0,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding Meta}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource ClickableCard}" Margin="0,0,0,8" Padding="20,16"
                                                MouseLeftButtonUp="OnCardClick" ToolTip="Open the burn chart">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="240" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" Style="{StaticResource BodyStrong}" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                        <TextBlock Text="{Binding LeftPercent}" Style="{StaticResource BigNumber}" />
                                                        <TextBlock Text="left" Style="{StaticResource Caption}" FontSize="14" Margin="6,0,0,7" VerticalAlignment="Bottom" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                        <TextBlock Text="{Binding StatusGlyph}" Style="{StaticResource Glyph}" FontSize="12" Foreground="{Binding StatusBrush}" />
                                                        <TextBlock Text="{Binding PaceText}" Style="{StaticResource Caption}" Foreground="{Binding StatusBrush}" Margin="6,0,0,0" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                                    <c:LimitBar Left="{Binding LeftFraction}" TimeLeft="{Binding TimeLeftFraction}" Status="{Binding Status}" Height="24" />
                                                    <Grid Margin="0,10,0,0">
                                                        <TextBlock Text="{Binding Usage}" Style="{StaticResource Caption}" />
                                                        <TextBlock Text="{Binding ResetText}" ToolTip="{Binding ResetTooltip}" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                                                    </Grid>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
