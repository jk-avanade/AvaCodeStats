<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Only for the tray NotifyIcon; WPF has no tray icon of its own. -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>AvaCodeStats</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WPF0001: the WPF Fluent theme (ThemeMode) is marked experimental.
         WFO0003: the DPI settings stay in app.manifest because the app's windows are WPF, not WinForms. -->
    <NoWarn>$(NoWarn);WPF0001;WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Keep WPF types unambiguous; tray code names WinForms / System.Drawing types explicitly. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AvaCodeStats.Core\AvaCodeStats.Core.csproj" />
  </ItemGroup>

</Project>
